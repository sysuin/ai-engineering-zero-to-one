# Copy this file to `.env` and fill in your own values.
# `.env` is listed in .gitignore and must never be committed.

# Required from Chapter 4 onward.
OPENAI_API_KEY=sk-your-key-here

# Optional. Only needed for the provider-portability sections in Chapter 27.
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# The book's own demo API (Chapter 3). This one is not a secret.
MERIDIAN_API_KEY=meridian-demo-key

# Safety rail for the build: refuse to run listings if a single pass would
# cost more than this many US dollars. Chapter 4 explains it.
BOOK_SPEND_CEILING_USD=2.00

# Token prices, in US dollars per million tokens, from the provider's pricing page.
# Left blank on purpose: the book reports token counts either way, and only reports
# dollars once you have supplied rates you have actually checked. Appendix C says
# where to find them.
# RATE_GPT_5_4_MINI_INPUT=
# RATE_GPT_5_4_MINI_OUTPUT=
# RATE_GPT_5_5_INPUT=
# RATE_GPT_5_5_OUTPUT=
