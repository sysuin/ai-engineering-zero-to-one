# Secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# Generated
# The Meridian dataset is regenerable in about 40 seconds from a fixed seed
# (python3 code/meridian/generate.py), so it does not belong in version control.
data/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editors and OS
.DS_Store
.idea/
.vscode/

# Built once from the corpus, regenerable
data/meridian/index/
data/meridian/chroma/

# The runner's per-call usage log: append-only output, a megabyte a run, and rewritten
# every time. `_report.json` next to it IS committed — it is the staleness cache, and a
# fresh clone needs it to know the captured output is current without re-running.
code/_usage.jsonl
